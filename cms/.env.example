# ── Lysdals CMS — environment ──────────────────────────────────────────────
# Copy to .env and adjust. Dev defaults use SQLite (zero setup); switch the
# provider in prisma/schema.prisma to "postgresql" + a postgres DATABASE_URL
# for production (the schema is cross-provider).
# .env må ALDRIG committes. Roter alle værdier hvis de nogensinde har været i git.

# SQLite (dev default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — uncomment after switching the prisma provider:
# DATABASE_URL="postgresql://user:password@localhost:5432/lysdals_cms?schema=public"

# Auth.js — PÅKRÆVET. Generate with: openssl rand -base64 32  (min. 32 tegn; unik pr. miljø)
AUTH_SECRET=""
# Bag proxy/hosting (Vercel, nginx): Auth.js skal stole på host-headeren
# AUTH_TRUST_HOST=true

# Public app URL (used by Auth.js callbacks, canonical URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Standardinstans når host ikke matcher en by (fx localhost)
DEFAULT_SITE_DOMAIN="slagelselokalt.dk"

# ── AI-assistent (/redaktion/chat → /api/chat) ─────────────────────────────
# Uden nøgle svarer /api/chat med 503. Hold nøglen server-side (aldrig NEXT_PUBLIC_).
ANTHROPIC_API_KEY=""
# Valgfri model-override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Agent-indtag (/api/ingest/*) ───────────────────────────────────────────
# Nøgler gemmes IKKE i miljøvariabler: de oprettes pr. instans og gemmes som sha256-hash i tabellen ApiKey.
#   npm run ingest:key -- --domain naestvedlokalt.dk --name "aI-library / Graver"
# Agent-siden (aI-library / Knowledge OS) gemmer klartekst-nøglen i sit eget secret store, fx:
# CMS_INGEST_BASE_URL="https://naestvedlokalt.dk"
# CMS_INGEST_API_KEY="lk_…"

# ── Modulær forside / AI-forslag (T11/T12) ────────────────────────────────
# Cron-ruten GET|POST /api/cron/frontpage-rank opretter FORSLAG til forsiden (publicerer aldrig; en redaktør godkender).
# Påkrævet for at ruten overhovedet svarer (ellers 503). Min. 16 tegn; generér med: openssl rand -base64 32
# Kald: curl -H "Authorization: Bearer $CRON_SECRET" "https://<host>/api/cron/frontpage-rank"   (valgfrit ?instans=<id>&ai=0)
# Vercel Cron sender headeren automatisk når CRON_SECRET er sat som miljøvariabel.
CRON_SECRET=""
# Hvor længe en godkendt forside vises før den udløber og fallback (deterministisk score -> seneste nyt) overtager (timer, 1–168; default 24)
# FRONTPAGE_SNAPSHOT_TTL_HOURS="24"

# ── Seed (kun dev/staging; seed afviser NODE_ENV=production) ───────────────
# Adgangskode til demo-brugerne (min. 12 tegn). Hvis tom, genereres en tilfældig og vises i terminalen.
# SEED_DEMO_PASSWORD=""

# ── Drift ──────────────────────────────────────────────────────────────────
# Rate limits og login-lockout er proces-lokale (lib/ratelimit). I produktion med flere instanser:
# tilslut en delt store (Redis/Upstash eller Postgres) via setRateLimitStore().
# REDIS_URL=""
